# Server
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gasp

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# Firebase Admin SDK
FIREBASE_PROJECT_ID=gasp-cab37
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# CORS
CORS_ORIGIN=http://localhost:8081

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Business Studio (safe-off defaults) ─────────────────────────────────────
# Master on/off switch. Must be explicitly set to 'true' to allow publishing.
# Setting to 'false' is the immediate rollback mechanism for publishing (R6.3).
BUSINESS_STUDIO_ENABLED=false

# Comma-separated list of workspace IDs whose owners may enter Studio even when
# the feature flag is off. Publishing is still denied regardless (R6.3).
BUSINESS_STUDIO_ALLOWED_WORKSPACE_IDS=

# Maximum number of opted-in followers who receive a single campaign broadcast.
# 0 is a valid value: delivery is prevented but the feature remains otherwise
# enabled and Studio entry is unaffected (R6.2).
BUSINESS_STUDIO_FOLLOWER_CAP=20

# Maximum number of campaigns a workspace may publish per calendar day.
BUSINESS_STUDIO_CAMPAIGNS_PER_DAY=1

# Number of delivery records processed per BullMQ fan-out job chunk.
BUSINESS_STUDIO_FANOUT_CHUNK_SIZE=20
