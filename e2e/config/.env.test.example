# ─────────────────────────────────────────────────────────────────────────────
# E2E Test Environment Variables — GASP
# Copy this file to .env.test and fill in real values.
# .env.test is listed in .gitignore — NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Personal user (pre-registered in staging, has at least 1 friend) ─────────
GASP_PERSONAL_PHONE=+5511999990001
GASP_PERSONAL_OTP=123456          # Firebase Auth emulator hardcoded OTP

# ── Business user (pre-registered in staging, accountType=business) ───────────
GASP_BUSINESS_PHONE=+5511999990002
GASP_BUSINESS_OTP=123456

# ── Relationship data (must exist before running tests) ───────────────────────
GASP_FRIEND_NAME=Test Friend       # displayName of the friend in inboxStore
GASP_FRIEND_USERNAME=testfriend    # username — used in search filter assertion
GASP_WORKSPACE_HANDLE=acmecorp     # business handle (without @)
GASP_CAMPAIGN_TITLE=Summer Drop 2026
