+    // GASP patch: while the front camera records a reaction, AVCaptureSession
+    // holds the session in .playAndRecord. Switching it to .playback (below)
+    // cuts the microphone mid-recording, so keep the recording category and
+    // only make sure playback is audible on the speaker and mixes in.
+    if audioSession.category == .playAndRecord {
+      var recordingOptions = audioSession.categoryOptions
+      recordingOptions.insert(.defaultToSpeaker)
+      recordingOptions.insert(.mixWithOthers)
+      if audioSession.categoryOptions != recordingOptions {
+        do {
+          try audioSession.setCategory(.playAndRecord, mode: audioSession.mode, options: recordingOptions)
+        } catch {
+          log.warn("Failed to keep the recording audio session while playing video. \(error.localizedDescription)")
+        }
+      }
+      return
+    }
